FIRECRAWL_API_KEY=your_firecrawl_api_key_here
OPENROUTER_API_KEY=
DEFAULT_MODEL=openrouter/free

# MiMo Prepaid Failover (Xiaomi MiMo V2.5)
MIMO_PREPAID_API_KEY=your-mimo-prepaid-api-key-here
MIMO_PREPAID_MODEL=mimo-v2.5
MIMO_PREPAID_URL=https://api.xiaomimimo.com/v1/chat/completions

# Supabase — shared database across ecosystem
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Contact form email (shared Resend account for every generated site)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Website Enquiries <no-reply@sitespire.co.za>"
# Optional fallback recipient if a site has no dashboard email set:
# CONTACT_FORM_FALLBACK_TO=you@sitespire.co.za

# Vercel auto-deploy (optional � CLI login is used when VERCEL_TOKEN is unset)
# VERCEL_TOKEN=vca_xxxxxxxxxxxx
# VERCEL_TEAM_ID=team_XTjPmNDfIpwUurCwxPkfPhip

# Public trial subdomain suffix (wildcard DNS already on *.sitespire.co.za)
TRIAL_DOMAIN_SUFFIX=sitespire.co.za

# GeistCRM (for build-ready email deep links) — builder is :3000, CRM is :3001
CRM_BASE_URL=http://localhost:3001
BUILD_NOTIFY_EMAIL=sean@sitespire.co.za
