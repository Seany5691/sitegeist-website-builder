# Vercel Environment Variables (Import this file to Vercel)
# IMPORTANT: Use this file for Vercel import, NOT .env.local
# Dollar signs are NOT escaped for Vercel — use the Base64 hash below

# Dashboard Authentication
DASHBOARD_USERNAME=admin
# IMPORTANT: Use Base64 encoded hash for Vercel (Vercel strips $ symbols)
DASHBOARD_PASSWORD_HASH_BASE64=JDJhJDEwJHZOMUFhWXA3RE96MDRzVFVWQlc1NGUzdFkuSmRhMkJFRlVyanRYRkdpYWJQazZIOWM1TGpD

# NextAuth Configuration
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-site.vercel.app

# Vercel Blob Storage (REQUIRED in production — auto-added when Blob store is linked)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXX

# Contact form email delivery (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Website Enquiries <no-reply@yourbuilder.com>"
